{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tmis",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "TmisContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TMIS_CONTAINER",
        "class_name": "TmisContainer"
      }
    ]
  },
  "exports": {
    "TmisContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "APP_NAME": "TMIS",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://tmis.markkinnedyanda.workers.dev",
    "APP_TIMEZONE": "Asia/Manila",
    "TRUSTED_PROXIES": "*",
    "BCRYPT_ROUNDS": "12",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "warning",
    "DB_CONNECTION": "pgsql",
    "DB_SSLMODE": "require",
    "SESSION_DRIVER": "database",
    "SESSION_LIFETIME": "120",
    "SESSION_ENCRYPT": "true",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_SAME_SITE": "lax",
    "CACHE_STORE": "database",
    "QUEUE_CONNECTION": "sync",
    "FILESYSTEM_DISK": "s3",
    "UPLOADS_DISK": "s3",
    "AWS_DEFAULT_REGION": "auto",
    "AWS_BUCKET": "tmis-production-files",
    "AWS_ENDPOINT": "https://57af58e4530a8e929078dda20830d7d7.r2.cloudflarestorage.com",
    "AWS_USE_PATH_STYLE_ENDPOINT": "false",
    "TMIS_BOOTSTRAP_DATA_KEY": "bootstrap/initial-state.json",
    "MAIL_MAILER": "smtp",
    "MAIL_HOST": "smtp-relay.brevo.com",
    "MAIL_PORT": "587",
    "MAIL_SCHEME": "tls",
    "MAIL_FROM_ADDRESS": "tmis.mailing@gmail.com",
    "MAIL_FROM_NAME": "TMIS"
  }
}
